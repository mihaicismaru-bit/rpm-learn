{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rpm-s2b-browser-evidence/v1",
  "title": "RPM LEARN S2B Browser Acceptance Evidence",
  "type": "object",
  "required": ["schemaVersion", "checkpoint", "status", "phase", "classification", "startedAt", "finishedAt", "origin", "message", "assertions", "boundaries"],
  "properties": {
    "schemaVersion": {"const": "rpm-s2b-browser-evidence/v1"},
    "checkpoint": {"const": "RPM-S2B"},
    "status": {"enum": ["PASS", "BLOCKED", "FAIL"]},
    "phase": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "finishedAt": {"type": "string", "format": "date-time"},
    "browser": {"type": ["string", "null"]},
    "chromeExecutable": {"type": "string"},
    "origin": {"type": "string"},
    "message": {"type": "string"},
    "assertions": {"type": "array", "items": {"type": "string"}},
    "boundaries": {
      "type": "object",
      "required": ["productionRelease", "realUserData", "legalComplianceClaims", "certificateIssuance", "learningEngineSeparateFromComplianceEngine"],
      "properties": {
        "productionRelease": {"const": false},
        "realUserData": {"const": false},
        "legalComplianceClaims": {"const": false},
        "certificateIssuance": {"const": false},
        "learningEngineSeparateFromComplianceEngine": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
